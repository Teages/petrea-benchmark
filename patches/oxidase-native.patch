index 0000000..e23ed5c
--- /dev/null
+++ b/packages/native/bindings/src/lib.rs
@@ -0,0 +1,79 @@
+use std::{cell::RefCell, fmt::Write};
+
+use napi::{bindgen_prelude::*, Env, Error, JsString, Result, Status, Task};
+use napi_derive::napi;
+use oxidase::{oxc_diagnostics::NamedSource, SourceType};
+
+thread_local! {
+    static ALLOCATOR: RefCell<oxidase::Allocator> = Default::default();
+}
+
+/// Mirrors packages/wasm/bindings/src/lib.rs exactly — same allocator
+/// lifecycle, same default SourceType, same error formatting — so the only
+/// difference versus the published npm build is the JS-to-Rust backend.
+#[napi]
+pub fn transpile(source: String, path: Option<String>) -> Result<String> {
+    let source_type = source_type_for(path.as_deref())?;
+    ALLOCATOR.with_borrow_mut(|allocator| transpile_impl(allocator, source_type, source, path.as_deref()))
+}
+
+fn source_type_for(path: Option<&str>) -> Result<SourceType> {
+    match path {
+        Some(path) => SourceType::from_path(path)
+            .map_err(|e| Error::new(Status::GenericFailure, format!("{e}"))),
+        None => Ok(SourceType::ts()),
+    }
+}
+
+fn transpile_impl(
+    allocator: &mut oxidase::Allocator,
+    source_type: SourceType,
+    mut source: String,
+    path: Option<&str>,
+) -> Result<String> {
+    let ret = oxidase::transpile(allocator, source_type, &mut source);
+    allocator.reset();
+    if ret.parser_panicked {
+        let mut error_msg = String::new();
+        for error in ret.parser_errors {
+            let error = if let Some(path) = path {
+                error.with_source_code(NamedSource::new(path, source.clone()))
+            } else {
+                error.with_source_code(source.clone())
+            };
+            error_msg.write_fmt(format_args!("{:?}\n", error)).unwrap();
+        }
+        return Err(Error::new(Status::GenericFailure, error_msg));
+    }
+    Ok(source)
+}
+
+/// Local addition (upstream oxidase ships sync-only APIs): runs the same
+/// transpile on libuv's thread pool so concurrent callers can use all pool
+/// threads, mirroring how petrea's async API works.
+struct TranspileTask {
+    source: String,
+    source_type: SourceType,
+    path: Option<String>,
+}
+
+impl Task for TranspileTask {
+    type Output = String;
+    type JsValue = JsString;
+
+    fn compute(&mut self) -> Result<Self::Output> {
+        ALLOCATOR.with_borrow_mut(|allocator| {
+            transpile_impl(allocator, self.source_type, std::mem::take(&mut self.source), self.path.as_deref())
+        })
+    }
+
+    fn resolve(&mut self, env: Env, output: Self::Output) -> Result<Self::JsValue> {
+        env.create_string_from_std(output)
+    }
+}
+
+#[napi(ts_return_type = "Promise<string>")]
+pub fn transpile_async(source: String, path: Option<String>) -> Result<AsyncTask<TranspileTask>> {
+    let source_type = source_type_for(path.as_deref())?;
+    Ok(AsyncTask::new(TranspileTask { source, source_type, path }))
+}
